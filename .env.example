# faker3 本地运行配置（复制此文件为 .env 后填写）
# 说明：本文件由 run.js 读取；已存在的系统环境变量优先，不会被 .env 覆盖。

# ===== 必填：京东 Cookie =====
# ★ 最省事的办法：直接双击 get-cookie.cmd（= tools/get-cookie.mjs）
#   它会用项目内独立浏览器配置 .jd-profile 打开 Edge，你扫码登录一次，
#   脚本就把整套 cookie（含 HttpOnly 的 thor/light_key/sdtoken）读出来写进 .env 的 JD_COOKIE。
#
# ★ 背景（2026 年起）：京东网页登录已经不再下发 pt_key / pt_pin 了。
#   现在有效的是 pin / thor / light_key / sdtoken 这一整套 cookie，faker3 的脚本照常能用；
#   只需要在 JD_COOKIE 末尾补一段 pt_pin=<你的pin>;，好让脚本能显示出账号名。
#   注意：不要自己伪造 pt_key=...，JD 会因此判定鉴权失败（实测会变成 0 豆 / 未实名）。
#
# 为什么 jd_CheckCK.js 会说「已失效」？
#   它按老格式（pt_key/pt_pin）判断，所以在新机制下必然误报；以 jd_bean_change.js 的输出为准。
#
# 手工获取（不想用 get-cookie.cmd 时）：
#   浏览器登录 https://www.jd.com → F12 → Application/应用 → Cookies → https://www.jd.com
#   把整张表里的 cookie 拼成 k=v; k=v; ... 一串，末尾加 pt_pin=<pin 那一条的值>; 填到下面
JD_COOKIE=pin=jd_xxxxxxxx; thor=xxxxxxxx; light_key=xxxxxxxx; sdtoken=xxxxxxxx; ...; pt_pin=jd_xxxxxxxx;
# 多账号：
#   方式一（推荐，一行写完）：用 & 连接两个账号各自的整套 cookie
#     JD_COOKIE=pin=jd_aaa; thor=...; pt_pin=jd_aaa;&pin=jd_bbb; thor=...; pt_pin=jd_bbb;
#   方式二：写成字面量 \n（两个字符，运行器会替换成换行）
#     JD_COOKIE=pin=jd_aaa; thor=...; pt_pin=jd_aaa;\npin=jd_bbb; thor=...; pt_pin=jd_bbb;

# ===== 可选：只跑/不跑某些账号 =====
# 只允许这些 pin 跑（英文逗号分隔多个）
# ALLOWPIN=jd_aaa,jd_bbb
# 屏蔽这些 pin
# BANPIN=jd_ccc
# 只允许跑的脚本白名单（& 分隔，一般不用设）
# PERMIT_JS=jd_CheckCK.js&jd_bean_change.js

# ===== 可选：网络 =====
# 账号代理池（需要 global-agent 支持，逗号分隔多个代理，脚本会随机分配）
# DP_POOL=http://127.0.0.1:7890
# 不走代理的地址，默认 127.0.0.1,localhost
# NO_PROXY=127.0.0.1,localhost

# ===== 可选：通知 =====
# 不配置时通知只打印到控制台。下面按需填一种即可（完整列表见 sendNotify.js 头部注释）。
# PUSH_KEY=
# PUSH_PLUS_TOKEN=
# BARK_PUSH=
# TG_BOT_TOKEN=
# TG_USER_ID=
# SERVERCHAN_SCKEY=

# ===== 可选：调试 / 特殊脚本 =====
# 设为 false 可关闭脚本里的 console 输出
# JD_DEBUG=true
# ===== 可选：京东试用（try.cmd）=====
# 本次最多申请几个（默认 5；京东每天 5 次额度）
# JD_TRY_MAXLENGTH=5
# 只申请某个类目：手机/phone（cid1=9987）、耳机/audio（652）、电脑（670）
# 等价于 try.cmd --category 手机；留空 = 不限类目
# JD_TRY_CATEGORY=phone
# 只申请标题/品牌/店铺含这些关键词的商品（逗号分隔，'-' 前缀排除）
# JD_TRY_KEYWORD=一加,OPPO
# 直接按京东一级类目 id 过滤（逗号分隔，与 JD_TRY_CATEGORY 叠加）
# JD_TRY_CID1=9987
# 关键词黑白名单，逗号分隔，'-' 前缀表示排除，例：耳机,手机,-奶粉
# JD_TRY_TITLEFILTERS=
# 申请人数超过该值就不申请（默认 200000，基本等于不限制）
# JD_TRY_APPLYNUMFILTER=200000
# 两次申请之间等待秒数（默认 8）
# JD_TRY_GAP=8

# 试用盯盘（try-watch.cmd）：轮询间隔秒数 / 最多盯几小时
JD_TRY_WATCH_INTERVAL=600
JD_TRY_WATCH_HOURS=12
# 仅原版 jd_try.js（try.cmd --upstream）需要：外部 H5ST 签名服务地址
# H5ST_SERVER=
