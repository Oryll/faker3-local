{
  "name": "faker3-local",
  "private": true,
  "version": "1.0.0",
  "description": "shufflewzc/faker3 本地运行模板：补齐依赖 + .env 配置 + 直接 node 运行（无需青龙）",
  "scripts": {
    "list": "node run.js --list",
    "check": "node run.js jd_CheckCK.js",
    "daily": "node run.js --group daily",
    "weekly": "node run.js --group weekly",
    "try": "node tools/run-try.cjs",
    "h5st": "node tools/local-h5st-server.cjs",
    "postinstall": "node tools/patch-deps.cjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "dependencies": {
    "axios": "^1.7.0",
    "big-integer": "1.6.52",
    "cheerio": "1.0.0",
    "console-table-printer": "^2.12.0",
    "crc": "^4.3.2",
    "crypto-js": "^4.2.0",
    "date-fns": "3.6.0",
    "dotenv": "^16.4.0",
    "ds": "2.0.2",
    "global-agent": "^3.0.0",
    "got": "^11.8.6",
    "http-cookie-agent": "1.0.6",
    "https-proxy-agent": "7.0.5",
    "iconv-lite": "0.6.3",
    "ini": "^4.1.3",
    "jsdom": "24.1.1",
    "moment": "2.30.1",
    "png-js": "1.0.0",
    "qs": "6.11.0",
    "redis": "^4.7.0",
    "request": "2.88.2",
    "sharp": "^0.34.0",
    "socks-proxy-agent": "6.2.1",
    "tough-cookie": "^4.1.4",
    "tunnel": "^0.0.6"
  }
}
